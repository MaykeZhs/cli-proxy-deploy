# Optional Sub2API companion stack.
# The deploy scripts generate sub2api.env with secure secrets on first use.

# Keep loopback for local-only access. Use 0.0.0.0 only with a firewall,
# strong credentials, and an HTTPS reverse proxy.
SUB2API_BIND_HOST=127.0.0.1
SUB2API_PORT=8321

# Official upstream images. Pin a release tag or digest if you need repeatable builds.
SUB2API_IMAGE=weishaw/sub2api:latest
SUB2API_POSTGRES_IMAGE=postgres:18-alpine
SUB2API_REDIS_IMAGE=redis:8-alpine

SUB2API_SERVER_MODE=release
SUB2API_RUN_MODE=standard
SUB2API_TZ=Asia/Shanghai

# Each dependency can be managed by this project or supplied externally.
# Valid combinations: managed/managed, managed/external, external/managed,
# or external/external.
SUB2API_POSTGRES_MODE=managed
SUB2API_DATABASE_HOST=postgres
SUB2API_DATABASE_PORT=5432
SUB2API_POSTGRES_USER=sub2api
SUB2API_POSTGRES_PASSWORD=replace-with-a-secure-random-value
SUB2API_POSTGRES_DB=sub2api
SUB2API_DATABASE_SSLMODE=disable

SUB2API_REDIS_MODE=managed
SUB2API_REDIS_HOST=redis
SUB2API_REDIS_PORT=6379
SUB2API_REDIS_PASSWORD=replace-with-a-secure-random-value
SUB2API_REDIS_DB=0

# For a service installed directly on the Docker host, use:
# SUB2API_DATABASE_HOST=host.docker.internal
# SUB2API_REDIS_HOST=host.docker.internal

SUB2API_ADMIN_EMAIL=admin@sub2api.local
SUB2API_ADMIN_PASSWORD=replace-with-a-secure-random-value
SUB2API_JWT_SECRET=replace-with-a-64-character-hex-value
SUB2API_TOTP_ENCRYPTION_KEY=replace-with-a-64-character-hex-value

# Upstream URL policy. These defaults support local/private HTTP upstreams.
# For a production-only HTTPS policy, set ALLOW_INSECURE_HTTP=false.
SUB2API_URL_ALLOWLIST_ENABLED=false
SUB2API_ALLOW_INSECURE_HTTP=true
SUB2API_ALLOW_PRIVATE_HOSTS=true

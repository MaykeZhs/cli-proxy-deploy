# Optional Cursor Bridge sidecar. Copy to cursor-bridge.env and chmod 600.
# Open cursor-bridge.env and fill these two lines. Do not paste keys into chat.
# Do not reuse CPA_API_KEY or CPA_MANAGEMENT_KEY.
#
# CURSOR_API_KEY: Cursor Dashboard → https://cursor.com/dashboard/api
#   Copy the full crsr_... value from the create-key dialog.
# CURSOR_BRIDGE_API_KEY: generate locally, must be 64 hex and different:
#   openssl rand -hex 32
#
# ask / force / MCP / multi-port are locked in docker-compose.cursor-bridge.yml.
# Do not add CURSOR_CONFIG_DIRS, CURSOR_ACCOUNT_DIRS, CURSOR_BRIDGE_WORKSPACE,
# or CURSOR_BRIDGE_CONTEXT_EXTRA — those are not locked and must stay unset.

CURSOR_API_KEY=replace-locally-with-cursor-dashboard-key
CURSOR_BRIDGE_API_KEY=replace-locally-with-random-64-hex-key

# Optional local overrides. Copy to .env if needed.

# Host address exposed by Docker Compose.
# Keep 127.0.0.1 for local-only access. Use 0.0.0.0 only if you intentionally expose the proxy.
CPA_BIND_HOST=127.0.0.1

# Optional read-only classification hint for capabilities/doctor.
# Use public-proxy only when CPA stays on loopback behind an HTTPS reverse proxy.
# This value never changes Docker port binding.
# CPA_EXPOSURE_MODE=public-proxy

# Host port exposed by Docker Compose.
CPA_PORT=8317

# Container image. Override this only when Docker Hub is unavailable.
CPA_IMAGE=eceasy/cli-proxy-api:latest

# Pull before normal starts. Update and rollback commands override this safely.
CPA_PULL_POLICY=always

# Optional fixed API key. If omitted, deploy.sh generates one.

# CPA_API_KEY=sk-your-local-api-key

# Optional management panel password. If omitted, deploy.sh can generate one.
# CPA_MANAGEMENT_KEY=your-panel-password

# Optional local overrides. Copy to .env if needed.

# Host port exposed by Docker Compose.
CPA_PORT=8317

# Optional fixed API key. If omitted, deploy.sh generates one.
# CPA_API_KEY=sk-your-local-api-key

# Optional management panel password. If omitted, deploy.sh can generate one.
# CPA_MANAGEMENT_KEY=your-panel-password
